{
  "name": "outdoorintel-reference-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Quality, provenance, and audit tooling for Outdoor Intel's Canadian outdoor dataset.",
  "type": "commonjs",
  "scripts": {
    "data:normalize": "node scripts/normalize-data.js",
    "data:validate": "node scripts/validate-data.js",
    "data:audit": "node scripts/build-reference-audit.js",
    "build:province-indexes": "node scripts/build-province-indexes.js",
    "inject:community": "node scripts/inject-community-intel.js",
    "build": "npm run build:scout-index && node scripts/regs/build-regs-index.mjs && astro build && node scripts/build/merge-legacy.mjs && node scripts/parity/compare.mjs --warn",
    "build:astro": "astro build",
    "parity:snapshot": "node scripts/parity/snapshot.mjs",
    "parity:compare": "node scripts/parity/compare.mjs",
    "build:css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind.input.css -o assets/css/site.css --minify",
    "build:scout-index": "node scripts/build-spots-index.js",
    "build:scout-page": "node scripts/build-scout-page.js",
    "build:field-notes": "node scripts/build-field-notes.js",
    "design:apply": "node scripts/apply-design-system.js",
    "links:clean": "node scripts/fix-internal-links.js",
    "quality": "npm run data:normalize && npm run build:province-indexes && npm run data:validate && npm run data:audit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "astro": "^7.1.6",
    "tailwindcss": "^3.4.17"
  }
}
