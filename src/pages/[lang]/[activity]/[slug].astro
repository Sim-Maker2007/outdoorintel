---
// Spot page template — replaces the 998 hand-generated en|fr spot HTML files.
// Every head signal and body section is a faithful port of the legacy
// generator + injector output; parity is enforced by scripts/parity/compare.mjs
// against scripts/parity/baseline.json.
import { loadSpots, gearMap as loadGearMap, linkConfig as loadLinkConfig } from '../../../lib/spots.mjs';
import { ACTIVITIES, ACTIVITY, T, metaDescription, fullDescription, pageTitle, imageAlt } from '../../../lib/labels.mjs';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import GlobalSearch from '../../../components/GlobalSearch.astro';
import GearChecklist from '../../../components/GearChecklist.astro';

export function getStaticPaths() {
  const { byActivity } = loadSpots();
  const paths = [];
  for (const activity of ACTIVITIES) {
    for (const spot of byActivity[activity]) {
      for (const lang of ['en', 'fr']) {
        paths.push({ params: { lang, activity, slug: spot.slug }, props: { spot, activity, lang } });
      }
    }
  }
  return paths;
}

const { spot, activity, lang } = Astro.props;
const { index } = loadSpots();
const gm = loadGearMap();
const linkCfg = loadLinkConfig();

const A = ACTIVITY[activity];
const SITE = 'https://outdoorintel.ca';
const url = `${SITE}/${lang}/${activity}/${spot.slug}`;
const enUrl = `${SITE}/en/${activity}/${spot.slug}`;
const frUrl = `${SITE}/fr/${activity}/${spot.slug}`;
const altHref = `/${lang === 'en' ? 'fr' : 'en'}/${activity}/${spot.slug}`;
const title = pageTitle(spot, activity, lang);
const desc = metaDescription(spot, activity, lang);
const heroDesc = fullDescription(spot, activity, lang);
const robots = spot.noindex
  ? 'noindex, follow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const heroImg = `${SITE}/assets/heros/${spot.hero_image}`;
const { lat, lng } = spot.coordinates;

// FR body copy falls back to the EN field when no *_fr exists — exactly the
// current site's behavior (only fishing/hunting carry FR narrative fields).
const t = (field) => (lang === 'fr' && spot[`${field}_fr`]) ? spot[`${field}_fr`] : spot[field];
const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const par = (s) => esc(s).replace(/\n\n/g, '<br/><br/>').replace(/\n/g, '<br/>');

// TouristAttraction JSON-LD: emitted only when the legacy structured-data
// text was harvested (schema_description); all other fields derive live.
const touristLd = spot.schema_description ? {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'Place'],
  name: spot.name,
  description: spot.schema_description,
  url,
  address: { '@type': 'PostalAddress', addressRegion: spot.province, addressCountry: 'CA' },
  isAccessibleForFree: true,
  publicAccess: true,
  touristType: A.title.en,
  geo: { '@type': 'GeoCoordinates', latitude: lat, longitude: lng },
  image: heroImg,
  keywords: spot.schema_keywords,
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Scout Level', value: spot.scout_level },
    { '@type': 'PropertyValue', name: 'Intel Grade', value: spot.intel_grade },
  ],
  sameAs: spot.website,
} : null;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: T.breadcrumbHome[lang], item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: A.title[lang], item: `${SITE}/${lang}/${activity}/directory` },
    { '@type': 'ListItem', position: 3, name: spot.name, item: url },
  ],
};

const heroCss = `
        .spot-hero {
            background: linear-gradient(135deg, rgba(45,90,61,0.3), rgba(62,49,39,0.2)), url('../../assets/heros/${spot.hero_image}');
            background-size: cover;
            background-position: center;
        }
    `;

const ga4Block = `<!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QY8Q00962P"><\/script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QY8Q00962P');
    <\/script>`;

const oiDsCss = '.explore-dropdown{visibility:hidden;opacity:0;transform:translateY(6px);transition:opacity .15s ease,transform .15s ease,visibility .15s}.explore-group:hover .explore-dropdown,.explore-group:focus-within .explore-dropdown{visibility:visible;opacity:1;transform:translateY(0)}';
const heroStyleBlock = `<style>${heroCss}<\/style>`;
const ldScript = (obj) => `<script type="application/ld+json">${JSON.stringify(obj)}<\/script>`;
const touristLdBlock = touristLd ? ldScript(touristLd) : '';
const breadcrumbLdBlock = ldScript(breadcrumbLd);
const oiDsStyleBlock = `<style id="oi-ds">${oiDsCss}<\/style>`;

// Hero stat card: activity-specific fields + Scout Level, per the legacy pages.
const stats = [
  ...A.stats.filter(s => spot[s.field]).map(s => ({ value: spot[s.field], label: s[lang], color: '#305e3c' })),
  { value: spot.scout_level, label: T.scoutLevel[lang], color: '#3d7a4d' },
];

const chips = spot[A.chipsField] || [];

const related = (spot.related_spots || [])
  .map(slug => index.get(`${activity}/${slug}`))
  .filter(Boolean);
const relSpecies = (rel) => (rel.primary_species || rel.primary_game || rel.features || []).slice(0, 2).join(', ');

const popupHtml = JSON.stringify('<strong>' + spot.name + '</strong><br>' + spot.province);
const mapScript = `
        (function(){
            var map = L.map('spot-mini-map', {scrollWheelZoom: false}).setView([${lat}, ${lng}], 10);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors',
                maxZoom: 18
            }).addTo(map);
            var marker = L.marker([${lat}, ${lng}]).addTo(map);
            marker.bindPopup(${popupHtml}).openPopup();
            setTimeout(function(){ map.invalidateSize(); }, 200);
        })();
        `;

const W = T.weatherStats;
const weatherScript = `
        (function(){
            var lat = ${lat}, lng = ${lng};
            var el = document.getElementById('weather-data');
            var WMO = {0:'Clear',1:'Mostly Clear',2:'Partly Cloudy',3:'Overcast',45:'Foggy',48:'Fog',51:'Light Drizzle',53:'Drizzle',55:'Heavy Drizzle',61:'Light Rain',63:'Rain',65:'Heavy Rain',71:'Light Snow',73:'Snow',75:'Heavy Snow',80:'Rain Showers',81:'Moderate Showers',82:'Heavy Showers',85:'Snow Showers',86:'Heavy Snow Showers',95:'Thunderstorm',96:'Thunderstorm + Hail',99:'Severe Thunderstorm'};
            var ICONS = {0:'☀️',1:'🌤️',2:'⛅',3:'☁️',45:'🌫️',48:'🌫️',51:'🌦️',53:'🌦️',55:'🌧️',61:'🌧️',63:'🌧️',65:'🌧️',71:'🌨️',73:'🌨️',75:'❄️',80:'🌦️',81:'🌧️',82:'⛈️',85:'🌨️',86:'❄️',95:'⛈️',96:'⛈️',99:'⛈️'};
            fetch('https://api.open-meteo.com/v1/forecast?latitude='+lat+'&longitude='+lng+'&current=temperature_2m,relative_humidity_2m,apparent_temperature,precipitation,weather_code,wind_speed_10m&timezone=auto')
            .then(function(r){return r.json()})
            .then(function(d){
                if(!d.current){el.innerHTML='<p class="text-[#5c6b5f]">Weather data unavailable.</p>';return;}
                var c=d.current;
                var code=c.weather_code||0;
                var icon=ICONS[code]||'🌡️';
                var desc=WMO[code]||'Unknown';
                el.innerHTML=
                    '<div class="flex items-center gap-6 flex-wrap">'+
                    '<div class="flex items-center gap-3">'+
                    '<span class="text-5xl">'+icon+'</span>'+
                    '<div><div class="text-4xl font-bold text-[#305e3c]">'+Math.round(c.temperature_2m)+'°C</div>'+
                    '<div class="text-sm text-[#5c6b5f]">'+desc+'</div></div></div>'+
                    '<div class="flex gap-6 flex-wrap text-sm">'+
                    '<div><div class="text-[#5c6b5f] text-xs uppercase font-semibold">${W.feels[lang]}</div><div class="font-bold text-[#305e3c]">'+Math.round(c.apparent_temperature)+'°C</div></div>'+
                    '<div><div class="text-[#5c6b5f] text-xs uppercase font-semibold">${W.wind[lang]}</div><div class="font-bold text-[#305e3c]">'+Math.round(c.wind_speed_10m)+' km/h</div></div>'+
                    '<div><div class="text-[#5c6b5f] text-xs uppercase font-semibold">${W.humidity[lang]}</div><div class="font-bold text-[#305e3c]">'+c.relative_humidity_2m+'%</div></div>'+
                    '<div><div class="text-[#5c6b5f] text-xs uppercase font-semibold">${W.precip[lang]}</div><div class="font-bold text-[#305e3c]">'+c.precipitation+' mm</div></div>'+
                    '</div></div>';
            })
            .catch(function(){el.innerHTML='<p class="text-[#5c6b5f]">Weather data unavailable. Check back later.</p>';});
        })();
        `;

const menuScript = `
const toggle = document.getElementById('menu-toggle');
const menu = document.getElementById('mobile-menu');
if (toggle && menu) {
    toggle.addEventListener('click', () => {
        menu.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', !menu.classList.contains('hidden'));
    });
}
`;
---
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#14251a">
    <link rel="alternate" type="application/rss+xml" title="Outdoor Intel Blog" href="https://outdoorintel.ca/rss.xml">
    <title>{title}</title>
    <meta name="description" content={desc}>
    <meta name="robots" content={robots}>
    <link rel="canonical" href={url}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={desc}>
    <meta property="og:image" content={heroImg}>
    <meta property="og:url" content={url}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Outdoor Intel">
    <meta property="og:locale" content={lang === 'en' ? 'en_CA' : 'fr_CA'}>
    <meta property="og:locale:alternate" content={lang === 'en' ? 'fr_CA' : 'en_CA'}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={desc}>
    <meta name="twitter:image" content={heroImg}>
    <link rel="alternate" hreflang="en" href={enUrl}>
    <link rel="alternate" hreflang="fr" href={frUrl}>
    <link rel="alternate" hreflang="x-default" href={enUrl}>
    <Fragment set:html={touristLdBlock} />
    <meta name="geo.position" content={`${lat};${lng}`}>
    <meta name="geo.region" content="CA">
    <meta name="geo.placename" content={`${spot.name}, ${spot.province}`}>
    <meta name="ICBM" content={`${lat}, ${lng}`}>
    <Fragment set:html={breadcrumbLdBlock} />
    <link rel="stylesheet" href="/assets/css/site.css?v=1">
    <Fragment set:html={heroStyleBlock} />
    <Fragment set:html={ga4Block} />
    <meta property="og:image:alt" content={imageAlt(spot, activity)}>
    <link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <script is:inline src="/assets/vendor/leaflet/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <Fragment set:html={oiDsStyleBlock} />
</head>
<body class="bg-[#fbfaf7] text-[#1c2b21] font-sans leading-relaxed">

    <Header lang={lang} altHref={altHref} />
    <nav class="max-w-7xl mx-auto px-6 py-3 flex items-center text-sm flex-wrap" aria-label="Breadcrumb">
            <a href="/" class="text-[#5c6b5f] hover:text-[#3d7a4d] transition-colors">{T.breadcrumbHome[lang]}</a><svg class="w-3 h-3 text-[#5c6b5f]/40 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg><a href={`/${lang}/${activity}/directory`} class="text-[#5c6b5f] hover:text-[#3d7a4d] transition-colors">{A.title[lang]}</a><svg class="w-3 h-3 text-[#5c6b5f]/40 mx-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg><span class="text-[#305e3c] font-semibold">{spot.name}</span>
        </nav>

    <main>
        <section class="spot-hero min-h-[55vh] flex flex-col justify-center pt-32 pb-12 relative">
            <div class="max-w-7xl mx-auto px-6 w-full relative z-10 flex flex-col flex-1 justify-center">
                <div class="max-w-3xl mb-16 lg:mb-20">
                    <div class="mb-6">
                        <span class="inline-block bg-white/90 text-[#3d7a4d] text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full">{A.badge[lang]}</span>
                    </div>
                    <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-4 leading-tight text-white drop-shadow-lg">
                        {spot.name}
                    </h1>
                    <p class="text-xl text-white/80 mb-4 drop-shadow">{spot.province}</p>
                    <p class="text-lg text-white/90 mb-10 max-w-xl leading-relaxed drop-shadow">{heroDesc}</p>
                    <div class="flex flex-wrap gap-4">
                        <a href={`/${lang}/${activity}/directory`} class="bg-[#305e3c] text-white px-8 py-4 font-semibold rounded-lg hover:bg-[#3d7a4d] transition-colors shadow-lg">{A.cta[lang]}</a>
                        {lang === 'en' && spot.website && <a href={spot.website} target="_blank" rel="noopener noreferrer" class="bg-white/90 text-[#305e3c] px-8 py-4 font-semibold rounded-lg hover:bg-white transition-colors shadow-lg inline-flex items-center gap-2">{T.officialWebsite.en} <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg></a>}
                    </div>
                </div>

                <div class="hidden lg:block mt-auto">
                    <div class="bg-white/95 backdrop-blur rounded-xl p-8 inline-block" style="box-shadow: 0 4px 12px rgba(62,49,39,0.1)">
                        <div class="flex flex-wrap gap-10">
                        {stats.map(s => (
                        <div>
                            <div class={`text-2xl font-bold text-[${s.color}]`}>{s.value}</div>
                            <div class="text-xs uppercase tracking-widest text-[#7a9b8e] font-semibold mt-1">{s.label}</div>
                        </div>
                        ))}
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-white py-16 px-6 -mt-8 relative z-20">
            <div class="max-w-7xl mx-auto">
                {chips.length > 0 && <div class="bg-[#f4f3ec] rounded-xl p-8 mb-10" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">
                    <h2 class="text-2xl font-bold text-[#305e3c] mb-6">{A.chipsHeading[lang]}</h2>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    {chips.map(chip => (
                    <div class="bg-white border border-[#305e3c]/10 rounded-lg p-4 flex items-center gap-3">
                        <div class="w-3 h-3 rounded-full bg-[#3d7a4d]"></div>
                        <span class="font-semibold text-[#305e3c]">{chip}</span>
                    </div>
                    ))}
                    </div>
                </div>}

                <div class="bg-[#305e3c] text-white rounded-xl p-8 mb-10">
                    <h2 class="text-2xl font-bold mb-4">{T.seasonalTips[lang]}</h2>
                    <p class="text-lg leading-relaxed text-white/90" set:html={par(t('seasonal_tips'))}></p>
                    <div class="mt-6 text-sm text-[#3d7a4d] font-semibold">{T.expertIntel[lang]}</div>
                </div>
            </div>
        </section>


        <section class="bg-white py-16 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="max-w-4xl">
                    <h2 class="text-3xl font-bold text-[#305e3c] mb-6">{T.about[lang]}</h2>
                    <p class="text-lg text-[#1c2b21] leading-relaxed" set:html={par(t('description'))}></p>
                </div>
            </div>
        </section>

        <section class="bg-white py-16 px-6" id="location-map">
            <div class="max-w-7xl mx-auto">
                <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-[#305e3c] rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
                        </div>
                        <h2 class="text-3xl font-bold text-[#305e3c]">{T.locationMap[lang]}</h2>
                    </div>
                    <a href={`/${lang}/map`} class="text-sm font-semibold text-[#3d7a4d] hover:text-[#305e3c] transition-colors">{T.fullMap[lang]}</a>
                </div>
                <div class="rounded-xl overflow-hidden border border-[#305e3c]/10" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">
                    <div id="spot-mini-map" style="height:400px;width:100%;"></div>
                </div>
                <p class="text-sm text-[#5c6b5f] mt-3">GPS: {lat}°N, {Math.abs(lng)}°W</p>
            </div>
        </section>
        <script is:inline set:html={mapScript}></script>
        <section class="bg-[#fbfaf7] py-16 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="bg-[#f4f3ec] rounded-xl p-8" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 bg-[#305e3c] rounded-lg flex items-center justify-center">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            </div>
                            <h3 class="text-xl font-bold text-[#305e3c]">{T.gettingThere[lang]}</h3>
                        </div>
                        <p class="text-[#1c2b21] leading-relaxed" set:html={par(t('getting_there'))}></p>
                    </div>
                    <div class="bg-[#f4f3ec] rounded-xl p-8" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 bg-[#305e3c] rounded-lg flex items-center justify-center">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8"/></svg>
                            </div>
                            <h3 class="text-xl font-bold text-[#305e3c]">{T.parking[lang]}</h3>
                        </div>
                        <p class="text-[#1c2b21] leading-relaxed" set:html={par(t('parking'))}></p>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-[#fbfaf7] py-12 px-6" id="weather-widget">
            <div class="max-w-7xl mx-auto">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 bg-[#3d7a4d] rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
                    </div>
                    <div>
                        <h2 class="text-2xl font-bold text-[#305e3c]">{T.weather[lang]}</h2>
                        <p class="text-xs text-[#5c6b5f]">{T.weatherSub[lang]}</p>
                    </div>
                </div>
                <div id="weather-data" class="bg-white rounded-xl p-6" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">
                    <p class="text-[#5c6b5f] text-sm">{T.weatherLoading[lang]}</p>
                </div>
            </div>
        </section>
        <script is:inline set:html={weatherScript}></script>
        <section class="bg-white py-16 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="max-w-4xl">
                    <h2 class="text-3xl font-bold text-[#305e3c] mb-6">{T.bestTime[lang]}</h2>
                    <p class="text-lg text-[#1c2b21] leading-relaxed" set:html={par(t('best_time'))}></p>
                </div>
            </div>
        </section>
        <section class="bg-[#fbfaf7] py-16 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="max-w-4xl">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-10 h-10 bg-[#3d7a4d] rounded-lg flex items-center justify-center">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/></svg>
                        </div>
                        <h2 class="text-3xl font-bold text-[#305e3c]">{T.terrain[lang]}</h2>
                    </div>
                    <p class="text-lg text-[#1c2b21] leading-relaxed" set:html={par(t('terrain'))}></p>
                </div>
            </div>
        </section>
        <section class="bg-[#305e3c] text-white py-16 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="max-w-4xl">
                    <h2 class="text-3xl font-bold mb-6">{T.regulations[lang]}</h2>
                    <p class="text-lg leading-relaxed text-white/90" set:html={par(t('regulations'))}></p>
                    {spot.reg_zone && <p class="mt-8"><a href={`/${lang}/fishing/regulations/zone-${spot.reg_zone.zone_id}`} class="inline-block bg-white/90 text-[#305e3c] px-6 py-3 font-semibold rounded-lg hover:bg-white transition-colors">{lang === 'fr'
                      ? `Limites et exceptions officielles — Zone ${spot.reg_zone.zone_id} (MELCCFP) →`
                      : `Official limits & exceptions — Zone ${spot.reg_zone.zone_id} (MELCCFP) →`}</a></p>}
                </div>
            </div>
        </section>
        <section class="bg-[#fbfaf7] py-16 px-6">
            <div class="max-w-7xl mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="bg-white rounded-xl p-8" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">
                        <h3 class="text-xl font-bold text-[#305e3c] mb-4">{T.nearbyServices[lang]}</h3>
                        <p class="text-[#1c2b21] leading-relaxed" set:html={par(t('nearby_services'))}></p>
                    </div>
                    <div class="bg-white rounded-xl p-8" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">
                        <h3 class="text-xl font-bold text-[#305e3c] mb-4">{T.whereToStay[lang]}</h3>
                        <p class="text-[#1c2b21] leading-relaxed" set:html={par(t('accommodation'))}></p>
                    </div>
                    <div class="bg-white rounded-xl p-8" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">
                        <h3 class="text-xl font-bold text-[#305e3c] mb-4">{T.cellSafety[lang]}</h3>
                        <p class="text-[#1c2b21] leading-relaxed" set:html={par(t('safety'))}></p>
                    </div>
                </div>
            </div>
        </section>

        {related.length > 0 && <section class="bg-[#f4f3ec] py-16 px-6">
            <div class="max-w-7xl mx-auto">
                <h2 class="text-3xl font-bold text-[#305e3c] mb-10">{T.nearbySpots[lang]}</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {related.map(rel => (
                <a href={`/${lang}/${activity}/${rel.slug}`} class="group hover:shadow-lg transition-all rounded-xl overflow-hidden hover:-translate-y-1" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">
                    <div class="bg-white p-8 h-full border-b-4 border-[#3d7a4d]">
                        <div class="text-[#3d7a4d] text-xs font-bold uppercase mb-2">{rel.province} &bull; {rel.scout_level}</div>
                        <h3 class="text-xl font-bold text-[#305e3c] mb-2">{rel.name}</h3>
                        <p class="text-[#5c6b5f] text-sm mb-3">{relSpecies(rel)}</p>
                        <div class="text-[#3d7a4d] text-sm font-semibold">{T.viewProfile[lang]}</div>
                    </div>
                </a>
                ))}
                </div>
            </div>
        </section>}


        <GearChecklist spot={spot} activity={activity} lang={lang} gearMap={gm} linkCfg={linkCfg} />


                <section class="bg-white py-16 px-6" id="community">
            <div id="ci-root" data-activity={activity} data-spot={spot.slug} data-lang={lang} data-name={spot.name}>
                <div class="max-w-4xl mx-auto text-center py-8 text-[#5c6b5f]">{T.ciLoading[lang]}</div>
            </div>
        </section>
    </main>

    <Footer lang={lang} altHref={altHref} />
    <script is:inline set:html={menuScript}></script>

    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <script is:inline>if('serviceWorker' in navigator){navigator.serviceWorker.register('/sw.js');}</script>

    <GlobalSearch />
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <script is:inline defer src="/assets/js/community-intel.js?v=1"></script>
    <script is:inline defer src="/assets/js/newsletter.js?v=1"></script>
    <script is:inline defer src="/assets/js/oi-plan.js?v=1"></script>
</body>
</html>
