---
// Regulations hub — lists the harvested Québec fishing zones with coverage
// and links each zone page. The chrome footer links here site-wide.
import { readFileSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import GlobalSearch from '../../../components/GlobalSearch.astro';
import { isGridJunkRule } from '../../../lib/regResolver.mjs';
import { regulationPageSlug, regulationKey } from '../../../lib/regsLookup.mjs';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const { lang } = Astro.params;
const L = lang === 'en' ? 'en' : 'fr';
const dir = join(process.cwd(), 'data', 'regulations');
const zones = readdirSync(dir).filter(f => f.endsWith('.json'))
  .map(f => JSON.parse(readFileSync(join(dir, f), 'utf-8')));
const qcZones = zones.filter(z => z.jurisdiction !== 'ON').sort((a, b) => a.zone_id - b.zone_id);
const onZones = zones.filter(z => z.jurisdiction === 'ON').sort((a, b) => a.fmz - b.fmz);

const SITE = 'https://outdoorintel.ca';
const url = `${SITE}/${lang}/fishing/regulations`;
const altHref = `/${lang === 'en' ? 'fr' : 'en'}/fishing/regulations`;

const T = {
  title: { en: 'Fishing Regulations — Québec Zones & Ontario FMZs', fr: 'Règlements de pêche — zones du Québec et ZGP de l’Ontario' },
  metaDesc: {
    en: 'Cited sport-fishing regulations: all Québec MELCCFP zones, plus Ontario FMZ 12, 16, 17 and 18 from the 2026 Fishing Regulations Summary HTML. Public, bilingual, free. Not complete Ontario. Always verify with the official source.',
    fr: 'Règlements de pêche sportive cités : toutes les zones MELCCFP du Québec, plus les ZGP 12, 16, 17 et 18 de l’Ontario d’après le HTML du Résumé 2026. Public, bilingue, gratuit. Pas l’Ontario au complet. Vérifiez toujours la source officielle.',
  },
  h1: { en: 'Fishing Regulations', fr: 'Règlements de pêche' },
  intro: {
    en: 'The official rules, made readable. Québec zone pages reproduce MELCCFP text. Ontario FMZ 12, 16, 17 and 18 reproduce the 2026 Ontario Fishing Regulations Summary HTML (the Summary is not the law). This is not complete Ontario. Always verify before you fish.',
    fr: 'Les règles officielles, enfin lisibles. Les pages du Québec reproduisent le MELCCFP. Les ZGP 12, 16, 17 et 18 de l’Ontario reproduisent le HTML du Résumé des règlements de la pêche 2026 (le Résumé n’est pas la loi). Ce n’est pas l’Ontario au complet. Vérifiez toujours avant de pêcher.',
  },
  qcHeading: { en: 'Québec fishing zones', fr: 'Zones de pêche du Québec' },
  onHeading: { en: 'Ontario fisheries management zones', fr: 'Zones de gestion des pêches de l’Ontario' },
  onNote: {
    en: 'Licence year 2026 (January 1–December 31). FMZ 12, 16, 17 and 18 only — not a complete Ontario harvest. Maps stay on Fish ON-Line.',
    fr: 'Année de permis 2026 (1er janvier–31 décembre). ZGP 12, 16, 17 et 18 seulement — pas une collecte complète de l’Ontario. Les cartes restent sur ON pêche en ligne.',
  },
  zone: { en: 'Zone', fr: 'Zone' },
  generalCount: { en: 'zone-wide rules', fr: 'règles de zone' },
  wbCount: { en: 'waterbody exceptions', fr: 'exceptions de plans d’eau' },
  view: { en: 'View regulations →', fr: 'Voir les règlements →' },
  updated: { en: 'Data retrieved', fr: 'Données récupérées le' },
  breadcrumbHome: { en: 'Home', fr: 'Accueil' },
  fishing: { en: 'Fishing', fr: 'Pêche' },
  searchTitle: { en: 'Look up a rule', fr: 'Chercher une règle' },
  searchIntro: {
    en: 'Search cited Québec MELCCFP or Ontario MNR Summary data by zone/FMZ, species, and optional waterbody. Results are verbatim source text — always verify with the official page before you fish.',
    fr: 'Cherchez dans les données citées du MELCCFP (Québec) ou du Résumé du MRN (Ontario) par zone/ZGP, espèce et plan d’eau (facultatif). Les résultats sont le texte intégral de la source — vérifiez toujours la page officielle avant de pêcher.',
  },
  qcGroup: { en: 'Québec', fr: 'Québec' },
  onGroup: { en: 'Ontario', fr: 'Ontario' },
  zoneLabel: { en: 'Zone', fr: 'Zone' },
  speciesLabel: { en: 'Species', fr: 'Espèce' },
  waterbodyLabel: { en: 'Waterbody (optional)', fr: 'Plan d’eau (facultatif)' },
  dateLabel: { en: 'Date (optional)', fr: 'Date (facultatif)' },
  searchBtn: { en: 'Search', fr: 'Rechercher' },
  speciesPh: { en: 'e.g. walleye', fr: 'ex. doré' },
  waterbodyPh: { en: 'e.g. barbue', fr: 'ex. barbue' },
  generalHeading: { en: 'Zone-wide rules', fr: 'Règles générales de la zone' },
  wbHeading: { en: 'Waterbody exceptions', fr: 'Exceptions par plan d’eau' },
  official: { en: 'Official source', fr: 'Source officielle' },
  fetched: { en: 'Data retrieved', fr: 'Données récupérées le' },
  wbNotFound: {
    en: 'No matching waterbody in this zone. Zone-wide rules are shown below — check the official source for that name.',
    fr: 'Aucun plan d’eau correspondant dans cette zone. Les règles générales s’affichent ci-dessous — vérifiez la source officielle pour ce nom.',
  },
  noRules: { en: 'No matching rules for this search.', fr: 'Aucune règle ne correspond à cette recherche.' },
  searching: { en: 'Loading…', fr: 'Chargement…' },
  searchError: { en: 'Could not load regulations. Try again.', fr: 'Impossible de charger les règlements. Réessayez.' },
  seasonCta: { en: 'Get Season Intel', fr: 'Obtenir Season Intel' },
  seasonCtaSub: {
    en: 'Cited seasons and exceptions. $29 CAD/year via Stripe Checkout. Change-alert emails are coming. Zone and FMZ pages stay free.',
    fr: 'Saisons et exceptions citées. 29 $ CAD/an via Stripe Checkout. Les courriels d’alerte s’en viennent. Les pages de zone et de ZGP restent gratuites.',
  },
  cols: {
    species: { en: 'Species', fr: 'Espèce' },
    limit: { en: 'Catch limit', fr: 'Limite de prise' },
    length: { en: 'Length limit', fr: 'Limite de longueur' },
    gear: { en: 'Gear', fr: 'Engin' },
    notes: { en: 'Notes', fr: 'Note' },
  },
};

const zoneLabel = (z) => (z.title[L] || z.title.en || `Zone ${z.zone_id}`).split('|')[0].trim();
const generalCount = (z) => (z.general[L] || []).filter(r => !isGridJunkRule(r)).length;
const exceptionCount = (z) => {
  if (z.jurisdiction === 'ON') {
    return (z.waterbody_exceptions?.[L] || []).length + (z.species_exceptions?.[L] || []).length;
  }
  return Array.isArray(z.waterbodies) ? z.waterbodies.length : 0;
};
const zoneHref = (z) => `/${lang}/fishing/regulations/${regulationPageSlug(z)}`;
const zoneValue = (z) => regulationKey(z);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: T.breadcrumbHome[L], item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: T.fishing[L], item: `${SITE}/${lang}/fishing/directory` },
    { '@type': 'ListItem', position: 3, name: T.h1[L], item: url },
  ],
};
---
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg?v=2">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png?v=2">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#14251a">
    <title>{T.title[L]} | Outdoor Intel</title>
    <meta name="description" content={T.metaDesc[L]}>
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <link rel="canonical" href={url}>
    <meta property="og:title" content={`${T.title[L]} | Outdoor Intel`}>
    <meta property="og:description" content={T.metaDesc[L]}>
    <meta property="og:url" content={url}>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Outdoor Intel">
    <meta property="og:locale" content={lang === 'en' ? 'en_CA' : 'fr_CA'}>
    <meta property="og:locale:alternate" content={lang === 'en' ? 'fr_CA' : 'en_CA'}>
    <link rel="alternate" hreflang="en" href={`${SITE}/en/fishing/regulations`}>
    <link rel="alternate" hreflang="fr" href={`${SITE}/fr/fishing/regulations`}>
    <link rel="alternate" hreflang="x-default" href={`${SITE}/en/fishing/regulations`}>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)}></script>
    <link rel="stylesheet" href="/assets/css/site.css?v=1">
    <Fragment set:html={`<!-- Google Analytics (GA4) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QY8Q00962P"><\/script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QY8Q00962P');
    <\/script>`} />
    <Fragment set:html={`<style id="oi-ds">.explore-dropdown{visibility:hidden;opacity:0;transform:translateY(6px);transition:opacity .15s ease,transform .15s ease,visibility .15s}.explore-group:hover .explore-dropdown,.explore-group:focus-within .explore-dropdown{visibility:visible;opacity:1;transform:translateY(0)}<\/style>`} />
</head>
<body class="bg-[#fbfaf7] text-[#1c2b21] font-sans leading-relaxed">
    <Header lang={lang} altHref={altHref} />

    <main class="pt-[88px]">
        <section class="bg-[#14251a] text-white py-16 px-6">
            <div class="max-w-5xl mx-auto">
                <span class="inline-block bg-white/90 text-[#3d7a4d] text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full mb-5">{T.fishing[L]} · Québec · Ontario</span>
                <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">{T.h1[L]}</h1>
                <p class="text-white/85 max-w-2xl text-lg">{T.intro[L]}</p>
                <a href={`/${lang}/season-intel`} class="inline-block mt-6 bg-[#a2c99a] text-[#14251a] font-bold px-6 py-3 rounded-lg hover:bg-white transition-colors">{T.seasonCta[L]}</a>
                <p class="text-white/70 text-sm mt-3 max-w-2xl">{T.seasonCtaSub[L]}</p>
            </div>
        </section>

        <section class="py-10 px-6 bg-[#f4f3ec] border-b border-[#305e3c]/10">
            <div class="max-w-5xl mx-auto">
                <h2 class="text-2xl font-bold text-[#305e3c] mb-2">{T.searchTitle[L]}</h2>
                <p class="text-sm text-[#5c6b5f] mb-6 max-w-2xl">{T.searchIntro[L]}</p>
                <form id="regs-search" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 items-end">
                    <label class="block text-sm">
                        <span class="font-semibold text-[#1c2b21]">{T.zoneLabel[L]}</span>
                        <select name="zone" required class="mt-1 w-full px-3 py-2 rounded-lg border border-[#305e3c]/20 bg-white text-[#1c2b21]">
                            <optgroup label={T.qcGroup[L]}>
                            {qcZones.map(z => (
                            <option value={zoneValue(z)}>{zoneLabel(z)}</option>
                            ))}
                            </optgroup>
                            {onZones.length > 0 && (
                            <optgroup label={T.onGroup[L]}>
                            {onZones.map(z => (
                            <option value={zoneValue(z)}>{zoneLabel(z)}</option>
                            ))}
                            </optgroup>
                            )}
                        </select>
                    </label>
                    <label class="block text-sm">
                        <span class="font-semibold text-[#1c2b21]">{T.speciesLabel[L]}</span>
                        <input type="text" name="species" placeholder={T.speciesPh[L]} class="mt-1 w-full px-3 py-2 rounded-lg border border-[#305e3c]/20 bg-white text-[#1c2b21]" autocomplete="off">
                    </label>
                    <label class="block text-sm">
                        <span class="font-semibold text-[#1c2b21]">{T.waterbodyLabel[L]}</span>
                        <input type="text" name="waterbody" placeholder={T.waterbodyPh[L]} class="mt-1 w-full px-3 py-2 rounded-lg border border-[#305e3c]/20 bg-white text-[#1c2b21]" autocomplete="off">
                    </label>
                    <label class="block text-sm">
                        <span class="font-semibold text-[#1c2b21]">{T.dateLabel[L]}</span>
                        <input type="date" name="date" class="mt-1 w-full px-3 py-2 rounded-lg border border-[#305e3c]/20 bg-white text-[#1c2b21]">
                    </label>
                    <button type="submit" class="bg-[#305e3c] text-white font-semibold px-4 py-2 rounded-lg hover:bg-[#3d7a4d] transition-colors">{T.searchBtn[L]}</button>
                </form>
                <div id="regs-results" class="mt-8 hidden"></div>
            </div>
        </section>

        <section class="py-14 px-6">
            <div class="max-w-5xl mx-auto">
                <h2 class="text-2xl font-bold text-[#305e3c] mb-6">{T.qcHeading[L]}</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {qcZones.map(z => (
                    <a href={zoneHref(z)} class="group bg-white rounded-xl border border-[#305e3c]/10 p-6 hover:shadow-lg transition-all hover:-translate-y-1" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">
                        <div class="text-[#3d7a4d] text-xs font-bold uppercase tracking-widest mb-2">Québec · MELCCFP</div>
                        <h3 class="text-2xl font-bold text-[#305e3c] mb-3">{zoneLabel(z)}</h3>
                        <p class="text-sm text-[#5c6b5f] mb-1">{generalCount(z)} {T.generalCount[L]}</p>
                        <p class="text-sm text-[#5c6b5f] mb-1">{exceptionCount(z)} {T.wbCount[L]}</p>
                        <p class="text-xs text-[#5c6b5f]/80 mb-4">{T.updated[L]} {z.source.fetched_at}</p>
                        <div class="text-[#3d7a4d] text-sm font-semibold">{T.view[L]}</div>
                    </a>
                    ))}
                </div>

                {onZones.length > 0 && (
                <div class="mt-14">
                    <h2 class="text-2xl font-bold text-[#305e3c] mb-2">{T.onHeading[L]}</h2>
                    <p class="text-sm text-[#5c6b5f] mb-6 max-w-2xl">{T.onNote[L]}</p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        {onZones.map(z => (
                        <a href={zoneHref(z)} class="group bg-white rounded-xl border border-[#305e3c]/10 p-6 hover:shadow-lg transition-all hover:-translate-y-1" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">
                            <div class="text-[#3d7a4d] text-xs font-bold uppercase tracking-widest mb-2">Ontario · MNR</div>
                            <h3 class="text-2xl font-bold text-[#305e3c] mb-3">{zoneLabel(z)}</h3>
                            <p class="text-sm text-[#5c6b5f] mb-1">{generalCount(z)} {T.generalCount[L]}</p>
                            <p class="text-sm text-[#5c6b5f] mb-1">{exceptionCount(z)} {T.wbCount[L]}</p>
                            <p class="text-xs text-[#5c6b5f]/80 mb-1">{z.coverage?.complete ? (L === 'fr' ? 'Couverture HTML de cette ZGP : complète' : 'This FMZ HTML coverage: complete') : (L === 'fr' ? 'Couverture HTML de cette ZGP : partielle' : 'This FMZ HTML coverage: partial')}</p>
                            <p class="text-xs text-[#5c6b5f]/80 mb-4">{T.updated[L]} {z.source.fetched_at}</p>
                            <div class="text-[#3d7a4d] text-sm font-semibold">{T.view[L]}</div>
                        </a>
                        ))}
                    </div>
                </div>
                )}
            </div>
        </section>
    </main>

    <Footer lang={lang} altHref={altHref} />
    <Fragment set:html={`<script>
const toggle = document.getElementById('menu-toggle');
const menu = document.getElementById('mobile-menu');
if (toggle && menu) {
    toggle.addEventListener('click', () => {
        menu.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', !menu.classList.contains('hidden'));
    });
}
<\/script>`} />
    <GlobalSearch />
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <script is:inline define:vars={{ lang, ui: {
      official: T.official[L],
      fetched: T.fetched[L],
      generalHeading: T.generalHeading[L],
      wbHeading: T.wbHeading[L],
      wbNotFound: T.wbNotFound[L],
      noRules: T.noRules[L],
      searching: T.searching[L],
      searchError: T.searchError[L],
      cols: {
        species: T.cols.species[L],
        limit: T.cols.limit[L],
        length: T.cols.length[L],
        gear: T.cols.gear[L],
        notes: T.cols.notes[L],
      },
    } }}>
    (function () {
      var form = document.getElementById('regs-search');
      var out = document.getElementById('regs-results');
      if (!form || !out) return;
      function esc(s) {
        return String(s == null ? '' : s)
          .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }
      function cell(v) { return esc(v == null ? '' : v); }
      function ruleTable(rules) {
        var rows = (rules || []).map(function (r) {
          return '<tr class="border-t border-[#305e3c]/10 align-top">'
            + '<td class="p-3 font-semibold">' + cell(r.species)
            + (r.period ? '<div class="text-xs font-normal text-[#5c6b5f]">' + cell(r.period) + '</div>' : '')
            + '</td>'
            + '<td class="p-3">' + cell(r.limit) + '</td>'
            + '<td class="p-3">' + cell(r.length) + '</td>'
            + '<td class="p-3">' + cell(r.gear) + '</td>'
            + '<td class="p-3">' + cell(r.notes) + '</td></tr>';
        }).join('');
        return '<div class="overflow-x-auto rounded-xl border border-[#305e3c]/10 bg-white" style="box-shadow: 0 4px 12px rgba(62,49,39,0.08)">'
          + '<table class="w-full text-sm" style="border-collapse:collapse"><thead><tr class="bg-[#f4f3ec] text-left">'
          + '<th class="p-3 font-bold text-[#305e3c]">' + esc(ui.cols.species) + '</th>'
          + '<th class="p-3 font-bold text-[#305e3c]">' + esc(ui.cols.limit) + '</th>'
          + '<th class="p-3 font-bold text-[#305e3c]">' + esc(ui.cols.length) + '</th>'
          + '<th class="p-3 font-bold text-[#305e3c]">' + esc(ui.cols.gear) + '</th>'
          + '<th class="p-3 font-bold text-[#305e3c]">' + esc(ui.cols.notes) + '</th>'
          + '</tr></thead><tbody>' + rows + '</tbody></table></div>';
      }
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var fd = new FormData(form);
        var zone = (fd.get('zone') || '').toString().trim();
        var species = (fd.get('species') || '').toString().trim();
        var waterbody = (fd.get('waterbody') || '').toString().trim();
        var date = (fd.get('date') || '').toString().trim();
        var params = new URLSearchParams({ zone: zone, lang: lang });
        if (species) params.set('species', species);
        if (waterbody) params.set('waterbody', waterbody);
        if (date) params.set('date', date);
        out.classList.remove('hidden');
        out.textContent = ui.searching;
        fetch('/api/regulations?' + params.toString())
          .then(function (r) { if (!r.ok) throw new Error('http ' + r.status); return r.json(); })
          .then(function (data) {
            var cite = data.citation || {};
            var html = '<div class="bg-white rounded-xl border border-[#305e3c]/10 p-5 mb-6">'
              + '<p class="text-sm mb-1"><strong>' + esc(ui.official) + ':</strong> '
              + (cite.source ? '<a class="text-[#305e3c] underline" href="' + esc(cite.source) + '" target="_blank" rel="noopener noreferrer">' + esc(cite.source) + '</a>' : '')
              + '</p>'
              + '<p class="text-sm mb-1"><strong>' + esc(ui.fetched) + ':</strong> ' + esc(cite.fetched_at || '') + '</p>'
              + '<p class="text-sm text-[#5c6b5f]">' + esc(data.disclaimer || '') + '</p></div>';
            if (data.waterbody_not_found) {
              html += '<p class="text-sm text-[#b3452e] mb-4">' + esc(ui.wbNotFound) + '</p>';
            }
            html += '<h3 class="text-xl font-bold text-[#305e3c] mb-3">' + esc(ui.generalHeading) + '</h3>';
            if (data.general && data.general.length) html += ruleTable(data.general);
            else html += '<p class="text-sm text-[#5c6b5f] mb-6">' + esc(ui.noRules) + '</p>';
            if (data.waterbody) {
              html += '<h3 class="text-xl font-bold text-[#305e3c] mt-8 mb-2">' + esc(ui.wbHeading) + ' — ' + esc(data.waterbody.name) + '</h3>';
              html += ruleTable(data.waterbody.rules);
            }
            out.innerHTML = html;
          })
          .catch(function () { out.textContent = ui.searchError; });
      });
    })();
    </script>
</body>
</html>
