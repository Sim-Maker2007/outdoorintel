            </div>
        </section>
        <section class="bg-[#14251a] text-white py-12 px-6">
            <div class="max-w-5xl mx-auto">
                <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-3">{T.bottomTitle[L]}</h2>
                <p class="text-white/80 max-w-2xl mb-6">{T.bottomLead[L]}</p>
                <a href="#checkout" class="js-si-bottom-cta inline-block bg-white text-[#14251a] font-bold px-6 py-3 rounded-lg hover:bg-[#a2c99a] transition-colors">{T.checkoutBtn[L]}</a>
                <p class="js-si-bottom-wait hidden text-sm text-white/70">{T.bottomWait[L]}</p>
            </div>
        </section>
    </main>
    <Footer lang={lang} altHref={altHref} />
    <Fragment set:html={`<script>
const toggle = document.getElementById('menu-toggle');
const menu = document.getElementById('mobile-menu');
if (toggle && menu) {
    toggle.addEventListener('click', () => {
        menu.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', !menu.classList.contains('hidden'));
    });
}
<\/script>`} />
    <GlobalSearch />
