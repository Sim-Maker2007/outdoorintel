---
// Public demo of the outfitter guest-prep product (first B2B offer, ~C$199/mo pilots).
// Lodge copy is placeholder branding. Regulation links go only to live Outdoor Intel pages.
import PrepPage from '../../../components/PrepPage.astro';
import { getPrepLodge } from '../../../lib/prepLodges.mjs';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'fr' } }];
}

const { lang } = Astro.params;
const lodge = getPrepLodge('demo');
---
<PrepPage lang={lang} lodge={lodge} />
