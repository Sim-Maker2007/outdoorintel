# Outdoor Intel — serverless function environment variables (set in Vercel).
# Community Intel write functions (api/reports/*, api/corrections/*) need these.

# Supabase project (shared with LandLink).
SUPABASE_URL=https://vbvsgwiyzjsmxawxyisn.supabase.co

# Public anon key — safe to expose in the browser (used for reads).
SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never ship to the browser. Community write
# functions use it to bypass RLS after validating + rate-limiting requests.
SUPABASE_SERVICE_ROLE_KEY=

# Secret salt for hashing client IPs (rate limiting + flag dedup) so raw IPs are
# never stored. Set to any long random string; changing it resets rate windows.
COMMUNITY_IP_SALT=

# --- Scout (AI trip planner, api/scout/*) ---------------------------------
# OpenRouter API key (server only). Without it, /api/scout/plan returns 503 and
# the Scout UI shows a friendly "warming up" message.
OPENROUTER_API_KEY=

# Model slug OpenRouter should route to. Defaults to anthropic/claude-3.5-sonnet.
# Any OpenRouter-served model with tool/function-calling works.
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Optional: your site URL, sent to OpenRouter for attribution/analytics.
OPENROUTER_SITE_URL=https://outdoorintel.ca

# Origin the AI functions fetch /data/*.json from for full spot grounding
# (Ask-this-spot, Conditions). Defaults to https://www.outdoorintel.ca.
SITE_ORIGIN=https://www.outdoorintel.ca

# Rate limiting for AI endpoints uses the ai_usage table — run db/ai-usage.sql
# once in Supabase to enable it. Until then the guard fails open (allows).

# --- Season Intel checkout (api/stripe/*) ---------------------------------
# All four are required. If any is missing, /en/season-intel and
# /fr/season-intel stay waitlist-only and checkout APIs return
# 503 { "error": "checkout_not_configured" }. Never commit real secrets.
# Create a CAD $29/year recurring price in Stripe and paste its price_ id.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
