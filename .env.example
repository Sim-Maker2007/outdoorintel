# Outdoor Intel — serverless function environment variables (set in Vercel).
# Community Intel write functions (api/reports/*, api/corrections/*) need these.

# Supabase project (shared with LandLink).
SUPABASE_URL=https://vbvsgwiyzjsmxawxyisn.supabase.co

# Public anon key — safe to expose in the browser (used for reads).
SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never ship to the browser. Community write
# functions use it to bypass RLS after validating + rate-limiting requests.
SUPABASE_SERVICE_ROLE_KEY=

# Secret salt for hashing client IPs (rate limiting + flag dedup) so raw IPs are
# never stored. Set to any long random string; changing it resets rate windows.
COMMUNITY_IP_SALT=
